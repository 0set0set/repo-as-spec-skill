# Install hardening, following the canonical SCS baseline (see
# skills/repo-as-spec/references/supply-chain.md).
# SCS-11: block dependency lifecycle scripts (Shai-Hulud loader vector); the
# release tooling does not rely on them. Install with `npm ci --ignore-scripts`.
ignore-scripts=true
# SCS-05: refuse package versions younger than 14 days at the resolver level
# (npm's native age gate, npm >= 11.10.0).
min-release-age=14
fund=false
audit-level=moderate
