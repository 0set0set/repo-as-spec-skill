{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      { "changelogFile": "skills/repo-as-spec/CHANGELOG.md" }
    ],
    [
      "@semantic-release/exec",
      { "prepareCmd": "node scripts/sync-skill-version.mjs ${nextRelease.version}" }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "README.md",
          "skills/repo-as-spec/SKILL.md",
          "skills/repo-as-spec/INSTALL.md",
          "skills/repo-as-spec/README.md",
          "skills/repo-as-spec/CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
